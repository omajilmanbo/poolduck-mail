generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String          @db.VarChar(255)
  status         String          @default("active") @db.VarChar(32)
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  users          User[]
  subscription   Subscription?
  devices        Device[]
  locations      Location[]
  personMappings PersonMapping[]
  scanEvents     ScanEvent[]
  mailJobs       MailJob[]
  auditLogs      AuditLog[]

  @@map("tenants")
}

model User {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String      @map("tenant_id") @db.Uuid
  email          String      @db.VarChar(255)
  passwordHash   String      @map("password_hash") @db.VarChar(255)
  role           String      @db.VarChar(32)
  status         String      @default("active") @db.VarChar(32)
  lastLoginAt    DateTime?   @map("last_login_at")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")
  tenant         Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  scanEvents     ScanEvent[]
  auditLogs      AuditLog[]

  @@unique([tenantId, email])
  @@index([tenantId, role, status])
  @@map("users")
}

model Subscription {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @unique @map("tenant_id") @db.Uuid
  plan      String   @db.VarChar(64)
  status    String   @db.VarChar(32)
  startAt   DateTime @map("start_at")
  endAt     DateTime @map("end_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@map("subscriptions")
}

model Device {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String      @map("tenant_id") @db.Uuid
  deviceCode  String      @map("device_code") @db.VarChar(128)
  name        String      @db.VarChar(255)
  status      String      @default("active") @db.VarChar(32)
  lastSeenAt  DateTime?   @map("last_seen_at")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  scanEvents  ScanEvent[]

  @@unique([tenantId, deviceCode])
  @@map("devices")
}

model Location {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String          @map("tenant_id") @db.Uuid
  locationCode   String          @map("location_code") @db.VarChar(128)
  name           String          @db.VarChar(255)
  type           String          @db.VarChar(32)
  status         String          @default("active") @db.VarChar(32)
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  personMappings PersonMapping[]
  scanEvents     ScanEvent[]

  @@unique([tenantId, locationCode])
  @@index([tenantId, name])
  @@map("locations")
}

model PersonMapping {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  locationId String    @map("location_id") @db.Uuid
  scanCode   String    @map("scan_code") @db.VarChar(128)
  personName String    @map("person_name") @db.VarChar(255)
  email      String    @db.VarChar(255)
  status     String    @default("active") @db.VarChar(32)
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  location   Location  @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@unique([tenantId, locationId, scanCode])
  @@index([tenantId, locationId, status, updatedAt])
  @@map("person_mappings")
}

model ScanEvent {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String     @map("tenant_id") @db.Uuid
  deviceId        String?    @map("device_id") @db.Uuid
  locationId      String?    @map("location_id") @db.Uuid
  scanCode        String     @map("scan_code") @db.VarChar(128)
  scanType        String     @map("scan_type") @db.VarChar(32)
  rawPayload      String     @map("raw_payload") @db.Text
  receivedAt      DateTime   @map("received_at")
  createdByUserId String?    @map("created_by_user_id") @db.Uuid
  createdAt       DateTime   @default(now()) @map("created_at")
  tenant          Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  device          Device?    @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  location        Location?  @relation(fields: [locationId], references: [id], onDelete: SetNull)
  createdByUser   User?      @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  mailJobs        MailJob[]

  @@index([tenantId, receivedAt])
  @@index([tenantId, locationId, createdAt])
  @@map("scan_events")
}

model MailJob {
  id                String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String     @map("tenant_id") @db.Uuid
  scanEventId       String?    @map("scan_event_id") @db.Uuid
  toEmail           String     @map("to_email") @db.VarChar(255)
  subject           String     @db.VarChar(255)
  body              String     @db.Text
  templateKey       String     @map("template_key") @db.VarChar(128)
  status            String     @default("queued") @db.VarChar(32)
  retryCount        Int        @default(0) @map("retry_count")
  providerMessageId String?    @map("provider_message_id") @db.VarChar(255)
  errorMessage      String?    @map("error_message") @db.Text
  scheduledAt       DateTime?  @map("scheduled_at")
  sentAt            DateTime?  @map("sent_at")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")
  tenant            Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  scanEvent         ScanEvent? @relation(fields: [scanEventId], references: [id], onDelete: SetNull)

  @@index([tenantId, status, createdAt])
  @@map("mail_jobs")
}

model AuditLog {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String?  @map("tenant_id") @db.Uuid
  actorUserId  String?  @map("actor_user_id") @db.Uuid
  action       String   @db.VarChar(128)
  resourceType String   @map("resource_type") @db.VarChar(128)
  resourceId   String   @map("resource_id") @db.VarChar(128)
  result       String   @db.VarChar(32)
  metadataJson Json     @default("{}") @map("metadata_json") @db.JsonB
  createdAt    DateTime @default(now()) @map("created_at")
  tenant       Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  actorUser    User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@map("audit_logs")
}
