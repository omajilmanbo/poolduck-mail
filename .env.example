APP_ENV=local
APP_PORT=3001
FRONTEND_PORT=3000
API_BASE_URL=http://localhost:3001
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
POSTGRES_DB=poolduck_mail
POSTGRES_USER=poolduck_local
POSTGRES_PASSWORD=poolduck_local_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://poolduck_local:poolduck_local_password@localhost:5432/poolduck_mail
JWT_SECRET=please_change_me
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_REFRESH_TOKEN_TTL_SECONDS=604800
REFRESH_TOKEN_SECRET=please_change_me
PLATFORM_JWT_SECRET=please_change_me_platform_access
PLATFORM_REFRESH_TOKEN_SECRET=please_change_me_platform_refresh
PLATFORM_PROVISIONING_SECRET=please_change_me_with_at_least_32_characters
PLATFORM_JWT_ACCESS_TOKEN_TTL_SECONDS=900
PLATFORM_JWT_REFRESH_TOKEN_TTL_SECONDS=604800
AUTH_IDENTITY_HASH_SECRET=please_change_me
AUTH_LOGIN_RATE_WINDOW_MS=900000
AUTH_LOGIN_MAX_PER_IP=60
AUTH_LOGIN_MAX_PER_TENANT=100
AUTH_LOGIN_MAX_PER_IDENTIFIER=10
AUTH_LOGIN_MAX_PER_COMPOSITE=8
AUTH_ACCEPT_LEGACY_TENANT_UUID=false
MAIL_PROVIDER=mock
MAIL_MOCK_SEND_RESULT=success
REAL_MAIL_SEND_ENABLED=false
# Production-only ADR-024 record destruction; requires a separate release review.
RECORD_RETENTION_PROCESSOR_ENABLED=false
RECORD_RETENTION_BATCH_SIZE=100
# ADR-020: Staging-only aggregate metrics; this does not enable real mail.
OCI_MAIL_APP_ALERTS_ENABLED=false
OCI_MONITORING_REGION=
OCI_MONITORING_COMPARTMENT_ID=
# OCI settings are only considered for the explicitly selected Staging provider.
OCI_EMAIL_REGION=
OCI_EMAIL_SENDER_COMPARTMENT_ID=
OCI_EMAIL_FROM_ADDRESS=
OCI_EMAIL_MESSAGE_ID_DOMAIN=
LOG_LEVEL=debug
CORS_ORIGIN=http://localhost:3000
TENANT_CONTEXT_ENFORCED=true
# Synthetic platform data is opt-in and forbidden when NODE_ENV=production.
PLATFORM_SYNTHETIC_SEED=false
PLATFORM_SYNTHETIC_EMAIL=platform-admin@seed.example.local
PLATFORM_SYNTHETIC_PASSWORD=
