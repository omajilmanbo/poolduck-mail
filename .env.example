# Local application runtime
APP_ENV=local
APP_PORT=3001
FRONTEND_PORT=3000
POSTGRES_PORT=5432
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
API_BASE_URL=http://backend:3001
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=debug
TENANT_CONTEXT_ENFORCED=true

# Local PostgreSQL for Docker Compose. Replace before using outside local development.
POSTGRES_DB=poolduck_mail
POSTGRES_USER=poolduck
POSTGRES_PASSWORD=poolduck_local_password
DATABASE_URL=postgresql://poolduck:poolduck_local_password@localhost:5432/poolduck_mail

# Local-only placeholders. Do not reuse in staging or production.
JWT_SECRET=local_dev_only_change_me
REFRESH_TOKEN_SECRET=local_refresh_dev_only_change_me

# MVP mail provider remains mock/sandbox and must not send real email locally.
MAIL_PROVIDER=mock
MAIL_FROM_ADDRESS=no-reply@example.local
MAIL_SMTP_HOST=localhost
MAIL_SMTP_PORT=1025
MAIL_SMTP_USER=example_user
MAIL_SMTP_PASS=example_pass
